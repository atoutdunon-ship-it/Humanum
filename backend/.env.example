HC_ENV=dev
HC_JWT_SECRET=remplacer-par-un-secret-aleatoire-de-32-octets-minimum
HC_DATABASE_PLATFORM_URL=postgresql+asyncpg://humanum_platform:CHANGER@127.0.0.1:5433/humanum
HC_ANTHROPIC_API_KEY=
# Double authentification : clé(s) Fernet, la première chiffre (générer : python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
HC_MFA_KEYS=
HC_MFA_ENFORCED=true
HC_REDIS_URL=redis://127.0.0.1:6379/0
# Prise de rendez-vous Google (console Google Cloud, identifiants « Application Web »)
HC_PUBLIC_BASE_URL=http://localhost:3000
HC_GOOGLE_CLIENT_ID=
HC_GOOGLE_CLIENT_SECRET=
HC_GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
HC_ANTHROPIC_MODEL=claude-sonnet-5-5
# Facturation Stripe
HC_STRIPE_SECRET_KEY=
HC_STRIPE_WEBHOOK_SECRET=
HC_STRIPE_AUTOMATIC_TAX=false
